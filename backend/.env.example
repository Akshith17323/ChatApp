POSTGRES_USER=chatadmin
POSTGRES_PASSWORD=
POSTGRES_DB=chatapp
DATABASE_URL="postgresql://chatadmin:YOUR_RANDOM_PASSWORD@localhost:5432/chatapp?schema=public"
PORT=3000
BOT_MODE=false             # set to true to enable FactBot simulation

# Largest image/file upload in MB
MAX_UPLOAD_MB=10

# Longest an "upload from URL" download may take, in milliseconds
REMOTE_FETCH_TIMEOUT_MS=15000

# Comma-separated web origins; production defaults to no cross-origin access.
# CORS_ORIGINS=https://app.example.com
# Trust only your TLS reverse proxy's IP/CIDR; never use a public/unrestricted range.
# TRUST_PROXY=127.0.0.1
