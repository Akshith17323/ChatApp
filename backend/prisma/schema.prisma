// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(uuid())
  name                 String         @unique
  phone                String?
  passwordHash         String?
  bio                  String?
  createdConversations Conversation[] @relation("ConversationCreator")
  messages             Message[]
  files                File[]

  @@map("users")
}

model Conversation {
  id               String    @id @default(uuid())
  name             String?
  type             String    // "DM" | "GROUP"
  createdAt        DateTime  @default(now())
  createdBy        String
  creator          User      @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  participants_ids String[]
  messages         Message[]

  @@index([participants_ids], type: Gin)
  @@index([createdAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  content        String?
  imageInfo      String?
  createdAt      DateTime     @default(now())
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         Json
  // Optional attachment (image or file). Null for plain text messages.
  fileId         String?
  file           File?        @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

// An uploaded image or file. Clients send it as base64 or as a URL the server downloads;
// either way the bytes are stored here as binary.
model File {
  id         String    @id @default(uuid())
  name       String
  mimeType   String
  size       Int       // size in bytes (decoded, not base64)
  kind       String    // "IMAGE" | "FILE"
  data       Bytes
  sourceUrl  String?   // the link it was downloaded from; null for base64 uploads
  uploadedBy String
  uploader   User      @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  messages   Message[]

  @@index([uploadedBy])
  @@map("files")
}
